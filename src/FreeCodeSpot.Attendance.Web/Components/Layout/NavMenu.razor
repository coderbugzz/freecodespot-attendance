<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Attendance</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView Roles="@AppRoles.Manager">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="employees">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Employees
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@AppRoles.Manager">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="attendance">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Clock in and out
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@AppRoles.Manager">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="timesheets">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Timesheets
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@AppRoles.Manager">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reports">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Reports
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@AppPolicies.HasEmployeeRecord">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="my-attendance">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> My attendance
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="my-timesheet">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> My timesheet
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 signed-in">
                    <span class="nav-link">@context.User.Identity?.Name</span>
                </div>

                <div class="nav-item px-3">
                    <form action="logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="" />
                        <button type="submit" class="nav-link">Sign out</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">Sign in</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
