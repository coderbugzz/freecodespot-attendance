@page "/"
@attribute [Authorize]

<PageTitle>Attendance</PageTitle>

<h1>Employee Attendance System</h1>

<AuthorizeView>
    <p>
        Signed in as <strong>@context.User.Identity?.Name</strong>
        (@string.Join(", ", context.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(claim => claim.Value))).
    </p>
</AuthorizeView>

<AuthorizeView Policy="@AppPolicies.HasEmployeeRecord">
    <p>Open <a href="my-attendance">My attendance</a> to clock in and out and to see your latest records.</p>
</AuthorizeView>

<AuthorizeView Roles="@AppRoles.Manager">
    <Authorized>
        <p>
            A Blazor front end backed by an ASP.NET Core Web API. Open the
            <a href="employees">Employees</a> page to manage the roster the API serves.
        </p>
    </Authorized>
    <NotAuthorized>
        <p>
            A Blazor front end backed by an ASP.NET Core Web API. The employee roster is managed by managers.
        </p>
    </NotAuthorized>
</AuthorizeView>
